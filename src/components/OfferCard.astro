---
import type { Offer } from '../data/offers';

interface Props extends Offer {
	index: number;
}

const { slug, title, category, description, visual, priceLabel, index } = Astro.props;
const accents = {
	water: 'from-pond-200 to-pond-500',
	leaf: 'from-reed-200 to-reed-500',
	sand: 'from-sand-200 to-sand-500',
};
---

<a
	href={`/angebote/${slug}/`}
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-pond-300 hover:shadow-lg focus-visible:ring-3 focus-visible:ring-sand-400 focus-visible:outline-hidden"
	aria-label={`${title} ansehen`}
>
	<div class:list={['relative min-h-48 aspect-[16/10] overflow-hidden bg-gradient-to-br', accents[visual]]} aria-hidden="true">
		<span class="absolute left-5 top-5 z-10 font-display text-2xl text-pond-950/80">
			{String(index).padStart(2, '0')}
		</span>
		<div class="absolute -bottom-24 -right-16 h-64 w-[115%] -rotate-6 rounded-[50%] border-[1.5rem] border-white/30 bg-pond-700/50 transition duration-500 group-hover:-translate-y-2"></div>
	</div>
	<div class="flex flex-1 flex-col p-6 sm:p-7">
		<p class="text-xs font-bold tracking-[0.16em] text-pond-700 uppercase">{category}</p>
		<h2 class="mt-3 font-display text-3xl leading-tight text-pond-950 transition group-hover:text-pond-700">{title}</h2>
		<p class="mt-4 leading-7 text-stone-600">{description}</p>
		<div class="mt-auto flex items-end justify-between gap-4 pt-7">
			<div>
				<p class="text-xs font-bold tracking-wider text-stone-500 uppercase">Preisplatzhalter</p>
				<p class="mt-1 font-display text-2xl text-pond-950">{priceLabel}</p>
			</div>
			<span class="text-xl text-pond-700 transition group-hover:translate-x-1" aria-hidden="true">→</span>
		</div>
	</div>
</a>
