---
import { Image } from 'astro:assets';
import { formatPrice, type Offer } from '../data/offers';
import { visuals } from '../data/media';

interface Props extends Offer {
	index: number;
	class?: string;
}

const { slug, title, category, description, visual, pricing, index, class: className } = Astro.props;
const image = visuals[visual];
---

<a
	href={`/angebote/${slug}/`}
	class:list={[
		'group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-stone-200 bg-white transition duration-500 hover:-translate-y-1.5 hover:border-pond-300 hover:shadow-[0_24px_55px_rgba(16,38,28,0.12)] focus-visible:ring-3 focus-visible:ring-sand-400 focus-visible:outline-hidden',
		className,
	]}
	aria-label={`${title} ansehen`}
>
	<div class="relative aspect-[16/10] min-h-48 overflow-hidden bg-pond-100">
		<Image
			src={image.src}
			alt=""
			widths={[420, 640, 840]}
			sizes="(min-width: 1280px) 28vw, (min-width: 768px) 45vw, 86vw"
			class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-pond-950/45 via-transparent to-white/5" aria-hidden="true"></div>
		<span class="absolute left-5 top-5 z-10 grid size-10 place-items-center rounded-full border border-white/55 bg-pond-950/55 font-display text-xl text-white backdrop-blur">
			{String(index).padStart(2, '0')}
		</span>
		<span class="absolute bottom-4 left-5 text-[0.65rem] font-bold tracking-[0.12em] text-white/85 uppercase">KI-Visualisierung</span>
	</div>
	<div class="flex flex-1 flex-col p-6 sm:p-7">
		<p class="eyebrow">{category}</p>
		<h2 class="mt-3 font-display text-3xl font-semibold leading-[1.05] text-pond-950 transition group-hover:text-pond-700">{title}</h2>
		<p class="mt-4 leading-7 text-stone-600">{description}</p>
		<div class="mt-auto flex items-end justify-between gap-4 pt-7">
			<div>
				<p class="text-xs font-bold tracking-wider text-stone-500 uppercase">Do It Yourself</p>
				<p class="mt-1 font-display text-2xl font-semibold text-pond-950">{formatPrice(pricing.diyFrom)}</p>
			</div>
			<span class="text-xl text-pond-700 transition group-hover:translate-x-1" aria-hidden="true">→</span>
		</div>
	</div>
</a>
