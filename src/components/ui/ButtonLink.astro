---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'light';
	class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const variants = {
	primary: 'border-pond-700 bg-pond-700 text-white hover:border-pond-800 hover:bg-pond-800',
	secondary: 'border-stone-300 bg-white text-stone-800 hover:border-pond-600 hover:text-pond-700',
	light: 'border-sand-200 bg-sand-200 text-pond-950 hover:border-white hover:bg-white',
};
---

<a
	href={href}
	class:list={[
		'inline-flex items-center justify-center gap-x-2 rounded-full border px-5 py-3 text-sm font-semibold transition duration-300 focus-visible:ring-3 focus-visible:ring-sand-400 focus-visible:outline-hidden',
		variants[variant],
		className,
	]}
>
	<slot />
</a>
