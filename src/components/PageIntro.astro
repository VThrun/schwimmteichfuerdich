---
interface Props {
	eyebrow: string;
	title: string;
	text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="relative overflow-hidden border-b border-stone-200 bg-sand-50">
	<div class="absolute -right-24 -top-32 size-96 rounded-full border border-pond-800/10" aria-hidden="true"></div>
	<div class="mx-auto max-w-[85rem] px-4 pb-16 pt-20 sm:px-6 md:pb-24 md:pt-28 lg:px-8">
	<div class="max-w-4xl" data-reveal>
		<p class="eyebrow">{eyebrow}</p>
		<h1 class="mt-4 font-display text-5xl font-semibold leading-[0.95] tracking-[-0.025em] text-pond-950 sm:text-6xl lg:text-7xl">
			{title}
		</h1>
		<p class="mt-6 max-w-3xl text-lg leading-8 text-stone-600 sm:text-xl">{text}</p>
	</div>
	</div>
</section>
