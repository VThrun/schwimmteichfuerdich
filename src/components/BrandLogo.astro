---
interface Props {
	class?: string;
	inverse?: boolean;
}

const { class: className = 'h-auto w-36', inverse = false } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 238 62"
	role="img"
	aria-labelledby="brand-logo-title"
>
	<title id="brand-logo-title">Schwimmteich für Dich</title>
	<g fill="none" stroke-linecap="round" stroke-linejoin="round">
		<path
			d="M8 36c11-21 25-29 48-24-3 23-17 38-42 39"
			stroke={inverse ? '#ddc18a' : '#397f80'}
			stroke-width="3"
		/>
		<path d="M7 44c12-5 24-4 37 2" stroke={inverse ? '#87bdb9' : '#668354'} stroke-width="3" />
	</g>
	<text x="70" y="28" fill={inverse ? '#ffffff' : '#1e3a3d'} font-family="Georgia, serif" font-size="21">
		Schwimmteich
	</text>
	<text
		x="71"
		y="47"
		fill={inverse ? '#ddc18a' : '#4e6840'}
		font-family="Inter, system-ui, sans-serif"
		font-size="11"
		font-weight="700"
		letter-spacing="3"
	>
		FÜR DICH
	</text>
</svg>
