---
import { Image } from 'astro:assets';
import { galleryVisuals, type SiteVisual } from '../data/media';

interface Props {
	id: string;
	count?: number;
	compact?: boolean;
	items?: SiteVisual[];
}

const { id, count = galleryVisuals.length, compact = false, items: suppliedItems } = Astro.props;
const items = (suppliedItems ?? galleryVisuals).slice(0, count);
const mosaicClasses = [
	'col-span-2 row-span-2',
	'col-span-1 row-span-1',
	'col-span-1 row-span-1',
	'col-span-2 row-span-1',
	'col-span-1 row-span-2',
	'col-span-1 row-span-2',
	'col-span-2 row-span-1',
];
---

<div class="gallery" data-gallery={id}>
	<div
		class:list={[
			compact
				? 'grid gap-4 sm:grid-cols-2 lg:grid-cols-3'
				: 'grid auto-rows-[8rem] grid-cols-2 gap-4 sm:auto-rows-[11rem] md:grid-cols-4 lg:auto-rows-[13rem]',
		]}
	>
		{items.map((item, index) => (
			<button
				type="button"
				class:list={[
					'group relative isolate min-h-44 overflow-hidden rounded-[1.35rem] bg-pond-100 text-left transition duration-500 hover:-translate-y-1 hover:shadow-[0_22px_45px_rgba(16,38,28,0.18)] focus-visible:ring-3 focus-visible:ring-sand-400 focus-visible:outline-hidden',
					compact ? 'aspect-[4/3]' : mosaicClasses[index % mosaicClasses.length],
				]}
				data-gallery-trigger
				data-index={index}
				data-src={item.src.src}
				data-alt={item.alt}
				data-caption={item.caption}
				aria-label={`${item.caption} groß anzeigen`}
			>
				<Image
					src={item.src}
					alt={item.alt}
					widths={[420, 700, 1000]}
					sizes={compact ? '(min-width: 1024px) 30vw, (min-width: 640px) 48vw, 100vw' : '(min-width: 768px) 48vw, 100vw'}
					class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]"
				/>
				<span class="absolute inset-0 bg-gradient-to-t from-pond-950/55 via-transparent to-transparent" aria-hidden="true"></span>
				<span class="absolute bottom-4 left-4 right-4 text-xs font-bold tracking-[0.08em] text-white uppercase">
					{item.caption}
				</span>
			</button>
		))}
	</div>

	<dialog
		class="m-auto w-[min(92vw,72rem)] max-w-none overflow-hidden rounded-[2rem] bg-white p-0 text-stone-800 shadow-2xl backdrop:bg-pond-950/85"
		data-gallery-dialog
		aria-labelledby={`${id}-dialog-title`}
	>
		<div class="relative bg-pond-950">
			<img
				class="aspect-[16/10] w-full object-cover"
				src={items[0]?.src.src}
				alt={items[0]?.alt}
				data-gallery-visual
			/>

			<form method="dialog" class="absolute right-4 top-4">
				<button type="submit" class="flex size-11 items-center justify-center rounded-full bg-white/90 text-2xl text-pond-950 shadow-sm transition hover:bg-white" aria-label="Galerie schließen">×</button>
			</form>

			<button type="button" class="absolute left-4 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-2xl text-pond-950 shadow-sm transition hover:bg-white" data-gallery-previous aria-label="Vorheriges Bild">←</button>
			<button type="button" class="absolute right-4 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-2xl text-pond-950 shadow-sm transition hover:bg-white" data-gallery-next aria-label="Nächstes Bild">→</button>
		</div>
		<div class="flex items-center justify-between gap-6 px-5 py-4 sm:px-7">
			<h2 id={`${id}-dialog-title`} class="font-display text-xl font-semibold text-pond-950" data-gallery-label aria-live="polite">{items[0]?.caption}</h2>
			<p class="shrink-0 text-sm font-semibold text-stone-500" data-gallery-counter></p>
		</div>
	</dialog>
</div>

<script>
	const initializeGalleries = () => {
		document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
			if (gallery.dataset.initialized === 'true') return;
			gallery.dataset.initialized = 'true';

			const triggers = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-trigger]'));
			const dialog = gallery.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
			const label = gallery.querySelector<HTMLElement>('[data-gallery-label]');
			const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
			const visual = gallery.querySelector<HTMLImageElement>('[data-gallery-visual]');
			const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
			const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');

			if (!dialog || !label || !counter || !visual || !previous || !next || triggers.length === 0) return;

			let activeIndex = 0;
			let lastTrigger: HTMLButtonElement | null = null;

			const showItem = (index: number) => {
				activeIndex = (index + triggers.length) % triggers.length;
				const trigger = triggers[activeIndex];
				label.textContent = trigger.dataset.caption ?? 'Visualisierung';
				counter.textContent = `${activeIndex + 1} / ${triggers.length}`;
				visual.src = trigger.dataset.src ?? '';
				visual.alt = trigger.dataset.alt ?? '';
			};

			triggers.forEach((trigger, index) => {
				trigger.addEventListener('click', () => {
					lastTrigger = trigger;
					showItem(index);
					dialog.showModal();
				});
			});

			previous.addEventListener('click', () => showItem(activeIndex - 1));
			next.addEventListener('click', () => showItem(activeIndex + 1));
			dialog.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') showItem(activeIndex - 1);
				if (event.key === 'ArrowRight') showItem(activeIndex + 1);
			});
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});
			dialog.addEventListener('close', () => lastTrigger?.focus());
		});
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeGalleries);
	else initializeGalleries();
</script>
