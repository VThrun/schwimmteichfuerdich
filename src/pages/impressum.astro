---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const requiredDetails = [
	'Vollständiger Name oder Firma und Rechtsform',
	'Vertretungsberechtigte Person',
	'Ladungsfähige Anschrift',
	'Bestätigte Telefonnummer und E-Mail-Adresse',
	'Register, Registernummer und Umsatzsteuer-ID, sofern vorhanden',
	'Berufsrechtliche oder weitere Pflichtangaben, sofern anwendbar',
];
---

<BaseLayout
	title="Impressum"
	description="Impressum von Schwimmteich für Dich – Angaben befinden sich noch in fachlicher Prüfung."
	noindex
>
	<PageIntro
		eyebrow="Rechtliches"
		title="Impressum"
		text="Diese Seite ist als Struktur vorbereitet. Verbindliche Betreiberangaben werden erst nach vollständiger Lieferung und fachlicher Prüfung eingesetzt."
	/>

	<section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
		<div class="rounded-2xl border border-sand-400 bg-sand-50 p-6 sm:p-8" role="status">
			<p class="text-sm font-bold tracking-wider text-sand-800 uppercase">Entwurf – nicht veröffentlichungsreif</p>
			<p class="mt-3 leading-7 text-sand-900">
				Es fehlen noch rechtlich geprüfte Betreiber- und Kontaktangaben. Dieser Platzhalter ist
				mit <code class="rounded bg-white px-1.5 py-0.5 text-sm">noindex</code> gekennzeichnet.
			</p>
		</div>

		<div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
			<h2 class="font-display text-3xl text-pond-950">Noch benötigte Angaben</h2>
			<ul class="mt-6 grid gap-4">
				{requiredDetails.map((detail) => (
					<li class="flex items-start gap-3 text-stone-700">
						<span class="mt-1.5 size-2 shrink-0 rounded-full bg-pond-600"></span>
						{detail}
					</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>
