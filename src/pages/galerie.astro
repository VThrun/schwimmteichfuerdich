---
import GalleryGrid from '../components/GalleryGrid.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Galerie"
	description="Vorbereitete Galerie für spätere Referenzbilder von Schwimmteichen und Naturpools."
>
	<PageIntro
		eyebrow="Projekte & Eindrücke"
		title="Wasserwelten, die später für sich sprechen."
		text="Die Galerie zeigt bereits das responsive Gestaltungsraster. Freigegebene Projektbilder und Bildbeschreibungen werden später eingesetzt."
	/>

	<section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
		<GalleryGrid id="project-gallery" count={12} />
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-sand-300 uppercase">Eigene Idee im Kopf?</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl leading-tight sm:text-5xl">Lassen Sie uns über den passenden Rahmen sprechen.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Projekt anfragen</ButtonLink>
		</div>
	</section>
</BaseLayout>
