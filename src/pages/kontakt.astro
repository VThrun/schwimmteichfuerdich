---
import ContactForm from '../components/ContactForm.astro';
import VisualImage from '../components/VisualImage.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Kontakt"
	description="Erzählen Sie uns von Ihrem geplanten Schwimmteich, Naturpool oder Ihrer Gartengestaltung."
>
	<PageIntro
		eyebrow="Kontakt"
		title="Erzählen Sie uns von Ihrem Garten."
		text="Ob erste Idee oder bereits konkreter Plan: Mit ein paar Angaben schaffen Sie eine gute Grundlage für das erste Gespräch."
	/>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
		<div data-reveal>
			<p class="eyebrow">Anfrage vorbereiten</p>
			<h2 class="mt-3 font-display text-4xl font-semibold text-pond-950">Was schwebt Ihnen vor?</h2>
			<p class="mt-4 max-w-2xl leading-7 text-stone-600">Ein Foto des Gartens, ungefähre Maße und Ihre Wünsche helfen später bei der ersten Einschätzung. Das Formular zeigt im aktuellen statischen Design bereits den geplanten Ablauf, versendet aber noch keine Daten.</p>
			<div class="mt-8"><ContactForm /></div>
		</div>

		<aside class="space-y-5 lg:pt-12">
			<VisualImage visual="evening" class="aspect-[4/3] rounded-[2rem]" imageClass="object-[58%_center]" />
			<div class="divide-y divide-stone-200 overflow-hidden rounded-[1.5rem] border border-stone-200 bg-white">
				<div class="p-6"><p class="eyebrow">E-Mail</p><p class="mt-2 text-stone-600">Die bestätigte E-Mail-Adresse wird ergänzt.</p></div>
				<div class="p-6"><p class="eyebrow">Telefon</p><p class="mt-2 text-stone-600">Die bestätigte Telefonnummer wird ergänzt.</p></div>
				<div class="p-6"><p class="eyebrow">Einsatzgebiet</p><p class="mt-2 text-stone-600">Region Leipzig – genaue Angabe in Prüfung.</p></div>
			</div>
		</aside>
	</section>
</BaseLayout>
