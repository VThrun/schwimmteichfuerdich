---
import OfferCard from '../components/OfferCard.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import { offers, type Offer } from '../data/offers';
import BaseLayout from '../layouts/BaseLayout.astro';

const categories: Array<{
	name: Offer['category'];
	title: string;
	description: string;
}> = [
	{
		name: 'Vollverbau',
		title: 'Schwimmteiche mit klarem Holzverbau',
		description: 'Kompakt bis großzügig: Der Holzverbau gibt der Badezone eine klare Form und verbindet sie mit Terrasse und Garten.',
	},
	{
		name: 'Naturpool',
		title: 'Geradlinige Naturpools',
		description: 'Reduzierte Formen für natürliches Wasser – ohne die Optik eines klassischen blauen Pools.',
	},
	{
		name: 'Teilverbaute Variante',
		title: 'Teilverbaut und naturnah',
		description: 'Varianten mit bewusst reduzierter Konstruktion für unterschiedliche Grundstücke, Längen und Gartenkonzepte.',
	},
	{
		name: 'Individuell',
		title: 'Nach Wunsch geplant',
		description: 'Wenn keine Ausgangsvariante passt, entsteht die Wasserwelt aus den Möglichkeiten Ihres Grundstücks heraus.',
	},
];
---

<BaseLayout
	title="Schwimmteiche"
	description="Schwimmteiche und Naturpools aus Holz – von der kompakten Variante bis zur individuellen Planung."
>
	<PageIntro
		eyebrow="Zehn Ausgangspunkte"
		title="Schwimmteiche, die zu Ihrem Garten passen."
		text="Ob kleine Erfrischung, lange Schwimmbahn oder großzügige Luxusoase: Jede Variante verbindet natürliches Wasser, Holz und Bepflanzung zu einem Gartenbild."
	/>

	<section class="border-b border-stone-200 bg-white">
		<div class="mx-auto grid max-w-[85rem] gap-px bg-stone-200 px-4 py-12 sm:px-6 md:grid-cols-3 md:py-16 lg:px-8">
			<div class="bg-white py-5 pr-6 md:py-2">
				<p class="eyebrow">Konstruktion</p>
				<p class="mt-2 font-display text-2xl font-semibold text-pond-950">Holz im Mittelpunkt</p>
			</div>
			<div class="bg-white py-5 md:px-8 md:py-2">
				<p class="eyebrow">Wasseraufbereitung</p>
				<p class="mt-2 font-display text-2xl font-semibold text-pond-950">Im selben Becken</p>
			</div>
			<div class="bg-white py-5 md:pl-8 md:py-2">
				<p class="eyebrow">Eigenleistung</p>
				<p class="mt-2 font-display text-2xl font-semibold text-pond-950">Auf Wunsch selbst mitbauen</p>
			</div>
		</div>
	</section>

	<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
		{categories.map((category, categoryIndex) => {
			const categoryOffers = offers.filter((offer) => offer.category === category.name);
			return (
				<section class:list={[categoryIndex > 0 && 'mt-24 border-t border-stone-200 pt-20']} aria-labelledby={`category-${categoryIndex}`}>
					<div class="grid gap-5 lg:grid-cols-[0.7fr_1.3fr] lg:items-end" data-reveal>
						<div>
							<p class="eyebrow">{category.name}</p>
							<h2 id={`category-${categoryIndex}`} class="mt-3 font-display text-4xl font-semibold leading-tight text-pond-950 sm:text-5xl">{category.title}</h2>
						</div>
						<p class="max-w-2xl text-lg leading-8 text-stone-600 lg:justify-self-end">{category.description}</p>
					</div>
					<div class:list={['mt-10 grid gap-6', categoryOffers.length === 1 ? 'md:grid-cols-2' : 'md:grid-cols-2 xl:grid-cols-3']}>
						{categoryOffers.map((offer) => <OfferCard {...offer} index={offers.indexOf(offer) + 1} />)}
					</div>
				</section>
			);
		})}
		<p class="mt-12 text-xs leading-5 text-stone-500">Alle Preisangaben sind illustrative Designbeispiele, nicht fachlich freigegeben und kein verbindliches Angebot.</p>
	</div>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div data-reveal>
				<p class="text-xs font-bold tracking-[0.2em] text-sand-300 uppercase">Noch nicht entschieden?</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight sm:text-5xl">Wir finden die passende Größe und Bauweise gemeinsam.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Projekt besprechen</ButtonLink>
		</div>
	</section>
</BaseLayout>
