---
import OfferCard from '../components/OfferCard.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import { offers } from '../data/offers';
import BaseLayout from '../layouts/BaseLayout.astro';

const types = [
	{
		number: '01',
		title: 'Vollverbau',
		text: 'Eine umlaufende Holzkonstruktion fasst den Schwimmbereich. Im Ufer entsteht eine Pflanzzone, die den Folienrand verdecken kann.',
	},
	{
		number: '02',
		title: 'Naturpool',
		text: 'Geradlinige Beckenarchitektur und natürliche Wasseraufbereitung treffen aufeinander; die Folie bleibt im Schwimmbereich sichtbar.',
	},
	{
		number: '03',
		title: 'Teilverbaute Variante',
		text: 'Die Holzkonstruktion wird nur in Teilen der Teichgrube eingesetzt. Dadurch bleibt die Folie im Schwimmbereich größtenteils sichtbar.',
	},
];
---

<BaseLayout
	title="Angebote"
	description="Vorbereitete Varianten für Schwimmteiche, Naturpools, Badeteiche und individuelle Teichprojekte."
>
	<PageIntro
		eyebrow="Schwimmteiche & Naturpools"
		title="Die passende Form für Ihr Wasser."
		text="Zehn vorbereitete Varianten geben Orientierung – von der kompakten Abkühlung bis zum individuell geplanten Schwimmteich."
	/>

	<section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
		<div class="grid overflow-hidden rounded-2xl border border-stone-200 bg-white lg:grid-cols-3">
			{types.map((type, index) => (
				<article class:list={['p-7 sm:p-9', index > 0 && 'border-t border-stone-200 lg:border-l lg:border-t-0']}>
					<span class="text-xs font-bold text-pond-700">{type.number}</span>
					<h2 class="mt-8 font-display text-3xl text-pond-950">{type.title}</h2>
					<p class="mt-4 leading-7 text-stone-600">{type.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
			<div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
				<div>
					<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Varianten im Überblick</p>
					<h2 class="mt-4 max-w-3xl font-display text-4xl leading-tight text-pond-950 sm:text-5xl">
						Zehn Ausgangspunkte für Ihre Planung.
					</h2>
				</div>
				<p class="leading-7 text-stone-600">
					Die Karten führen zu vorbereiteten Detailseiten. Sämtliche Preise, Maße und
					Leistungsangaben bleiben bis zur Inhaltsfreigabe Platzhalter.
				</p>
			</div>

			<div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{offers.map((offer, index) => <OfferCard {...offer} index={index + 1} />)}
			</div>
		</div>
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-sand-300 uppercase">Noch nicht fündig?</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl leading-tight sm:text-5xl">Jeder Garten stellt eigene Fragen.</h2>
				<p class="mt-4 max-w-2xl text-pond-100">Eine individuelle Planung berücksichtigt Wünsche, Terrain und die baulichen Bedingungen vor Ort.</p>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Idee besprechen</ButtonLink>
		</div>
	</section>
</BaseLayout>
