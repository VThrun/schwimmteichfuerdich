---
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
	{
		number: '01',
		title: 'Im Zusammenhang denken',
		text: 'Wasserfläche, Filterzone, Konstruktion und Garten sollen am Ende als ein stimmiges Ganzes wirken.',
	},
	{
		number: '02',
		title: 'Ressourcen beachten',
		text: 'Material- und Technikentscheidungen werden mit Blick auf einen bewussten Umgang mit Ressourcen getroffen.',
	},
	{
		number: '03',
		title: 'Persönlich planen',
		text: 'Die Lösung richtet sich nach dem Grundstück und den Menschen, die den Garten nutzen.',
	},
];
---

<BaseLayout
	title="Über uns"
	description="Lernen Sie die Haltung und Arbeitsweise hinter Schwimmteich für Dich kennen."
>
	<PageIntro
		eyebrow="Über uns"
		title="Gute Teiche beginnen mit gutem Zuhören."
		text="Wir planen Wasserflächen als Teil des Gartens – sorgfältig, ressourcenbewusst und entlang der Wünsche, die ein Grundstück besonders machen."
	/>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 pb-20 sm:px-6 md:grid-cols-2 md:items-center md:pb-28 lg:px-8">
		<MediaPlaceholder label="Teamfoto wird ergänzt" variant="leaf" />
		<div>
			<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Unsere Haltung</p>
			<h2 class="mt-4 font-display text-4xl leading-tight text-pond-950 sm:text-5xl">
				Vom ersten Gespräch bis zur Bepflanzung.
			</h2>
			<div class="mt-6 grid gap-5 leading-7 text-stone-600">
				<p>
					Schwimmteich für Dich steht für anspruchsvolle Teichprojekte, bei denen Planung,
					Konstruktion und Gestaltung zusammengehören.
				</p>
				<p>
					Wer genau hinter dem Team steht, welche Erfahrung eingebracht wird und in welchem
					Gebiet Projekte umgesetzt werden, ergänzen wir nach redaktioneller Freigabe.
				</p>
			</div>
			<div class="mt-7 rounded-xl border border-sand-300 bg-sand-50 p-5 text-sm leading-6 text-sand-900">
				<strong class="block">Inhalt in Abstimmung</strong>
				Teamvorstellung, Portraits, Qualifikationen und das bestätigte Einsatzgebiet fehlen noch.
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
			<div class="max-w-3xl">
				<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Was uns leitet</p>
				<h2 class="mt-4 font-display text-4xl leading-tight text-pond-950 sm:text-5xl">
					Drei Grundsätze für jedes Projekt.
				</h2>
			</div>

			<div class="mt-12 grid gap-5 lg:grid-cols-3">
				{values.map((value) => (
					<article class="rounded-2xl border border-stone-200 bg-stone-50 p-7">
						<span class="text-xs font-bold text-pond-700">{value.number}</span>
						<h3 class="mt-8 font-display text-3xl text-pond-950">{value.title}</h3>
						<p class="mt-4 leading-7 text-stone-600">{value.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-sand-300 uppercase">Projektstart</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl leading-tight sm:text-5xl">Erzählen Sie uns von Ihrem Garten.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Kontakt aufnehmen</ButtonLink>
		</div>
	</section>
</BaseLayout>
