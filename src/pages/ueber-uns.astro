---
import VisualImage from '../components/VisualImage.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
	{ number: '01', title: 'Vom Garten aus denken', text: 'Wasserfläche, Ufer, Terrasse und Bepflanzung sollen sich wie ein gewachsener Teil des Grundstücks anfühlen.' },
	{ number: '02', title: 'Natürlich bauen', text: 'Holz steht im Mittelpunkt der Konstruktion und macht den naturnahen Charakter sichtbar.' },
	{ number: '03', title: 'Klar zusammenarbeiten', text: 'Sie sehen früh, welche Arbeiten Sie selbst übernehmen können und welche fachlich abgesichert bleiben.' },
];
---

<BaseLayout
	title="Über uns"
	description="Die Haltung hinter Schwimmteich für Dich: naturnahe Gartenplanung, Holzbauweise und eine transparente Zusammenarbeit."
>
	<PageIntro
		eyebrow="Unsere Haltung"
		title="Gute Teiche beginnen mit gutem Zuhören."
		text="Wir denken Wasserflächen nicht als isoliertes Produkt, sondern als persönlichen Lebensraum – passend zum Garten, zur Architektur und zu den Menschen, die ihn genießen."
	/>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:px-8">
		<VisualImage visual="generous" class="aspect-[4/3] rounded-[2rem]" />
		<div data-reveal>
			<p class="eyebrow">Garten statt Fremdkörper</p>
			<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Ein Schwimmteich soll wirken, als gehöre er genau hierhin.</h2>
			<p class="mt-6 text-lg leading-8 text-stone-600">Darum beginnt die Planung nicht mit einer Standardform, sondern mit dem Ort: Wie bewegt man sich durch den Garten? Wo entsteht Abendsonne? Wie können Holz, Wasser und Grün zu einer ruhigen Einheit werden?</p>
			<p class="mt-5 leading-7 text-stone-600">Wer hinter dem Team steht, welche Qualifikationen eingebracht werden und in welchem Gebiet Projekte umgesetzt werden, ergänzen wir nach redaktioneller Freigabe – bewusst ohne vorläufige Portraits oder unbestätigte Angaben.</p>
		</div>
	</section>

	<section class="border-y border-stone-200 bg-white">
		<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
			<div class="max-w-3xl" data-reveal><p class="eyebrow">Was uns leitet</p><h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Drei Grundsätze für jedes Projekt.</h2></div>
			<div class="mt-12 grid gap-5 lg:grid-cols-3">
				{values.map((value, index) => (
					<article class="rounded-[1.5rem] border border-stone-200 bg-stone-50 p-7" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
						<span class="text-xs font-bold text-sand-700">{value.number}</span><h3 class="mt-8 font-display text-3xl font-semibold text-pond-950">{value.title}</h3><p class="mt-4 leading-7 text-stone-600">{value.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-2 lg:items-center lg:px-8">
		<div data-reveal><p class="eyebrow">Mehr als ein Badeplatz</p><h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Ein lebendiger Ort für Sie und die Natur.</h2><p class="mt-6 text-lg leading-8 text-stone-600">Pflanzen machen den Teich nicht nur weich und wohnlich. Mit der Zeit kann ein neuer Lebensraum entstehen, den Libellen, Frösche und Vögel für sich entdecken.</p></div>
		<VisualImage visual="biotope" class="aspect-[4/3] rounded-[2rem]" />
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div data-reveal><p class="text-xs font-bold tracking-[0.2em] text-sand-300 uppercase">Projektstart</p><h2 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight sm:text-5xl">Erzählen Sie uns von Ihrem Garten.</h2></div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Kontakt aufnehmen</ButtonLink>
		</div>
	</section>
</BaseLayout>
