---
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import PageIntro from '../components/PageIntro.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
	'Aushub vorbereiten',
	'Poolbecken erstellen',
	'Teichrand ausbilden',
	'Filtermaterial einbringen',
	'Treppenstufen vorbereiten',
	'Pflanzflächen zonieren',
	'Bepflanzung einsetzen',
];
---

<BaseLayout
	title="Do It Yourself"
	description="Vorbereitetes Seitengerüst für den begleiteten Selbstbau eines Schwimmteichs oder Naturpools."
>
	<PageIntro
		eyebrow="Gemeinsam bauen"
		title="Do It Yourself – mit einer klaren Aufgabenverteilung."
		text="Diese Seite zeigt bereits den späteren Ablauf. Fachlich geprüfte Beschreibungen und Leistungsgrenzen werden nach der Inhaltsfreigabe ergänzt."
	/>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 pb-20 sm:px-6 md:grid-cols-2 md:items-center md:pb-28 lg:px-8">
		<MediaPlaceholder label="Baustellenaufnahme wird ergänzt" variant="sand" shape="landscape" />
		<div>
			<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Selbst mitgestalten</p>
			<h2 class="mt-4 font-display text-4xl leading-tight text-pond-950 sm:text-5xl">Eigenleistung und Facharbeit greifen ineinander.</h2>
			<p class="mt-6 leading-7 text-stone-600">Hier folgt später die freigegebene Erklärung zum begleiteten Selbstbau. Der aktuelle Text dient ausschließlich als Platzhalter für Umfang und Lesefluss.</p>
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
			<div class="max-w-3xl">
				<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Möglicher Ablauf</p>
				<h2 class="mt-4 font-display text-4xl leading-tight text-pond-950 sm:text-5xl">Schritt für Schritt zum eigenen Wasserprojekt.</h2>
			</div>
			<ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{steps.map((step, index) => (
					<li class:list={['flex min-h-64 flex-col justify-between rounded-2xl border p-7', index === 0 ? 'border-pond-800 bg-pond-800 text-white' : 'border-stone-200 bg-stone-50 text-pond-950']}>
						<span class:list={['text-xs font-bold', index === 0 ? 'text-sand-300' : 'text-pond-700']}>{String(index + 1).padStart(2, '0')}</span>
						<div>
							<h3 class="font-display text-3xl">{step}</h3>
							<p class:list={['mt-4 leading-7', index === 0 ? 'text-pond-100' : 'text-stone-600']}>Die genaue Beschreibung dieses Bauabschnitts wird nach fachlicher Prüfung ergänzt.</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
		<div class="grid overflow-hidden rounded-3xl border border-stone-200 bg-white lg:grid-cols-2">
			<article class="p-8 sm:p-10">
				<p class="text-xs font-bold tracking-wider text-reed-700 uppercase">Mögliche Eigenleistungen</p>
				<h2 class="mt-3 font-display text-3xl text-pond-950">Ihr Anteil am Projekt.</h2>
				<p class="mt-5 leading-7 text-stone-600">Eine freigegebene Übersicht der möglichen Eigenleistungen wird an dieser Stelle ergänzt.</p>
			</article>
			<article class="border-t border-stone-200 bg-pond-50 p-8 sm:p-10 lg:border-l lg:border-t-0">
				<p class="text-xs font-bold tracking-wider text-pond-700 uppercase">Leistungen des Fachbetriebs</p>
				<h2 class="mt-3 font-display text-3xl text-pond-950">Professionelle Unterstützung.</h2>
				<p class="mt-5 leading-7 text-stone-600">Die verbindliche Abgrenzung von Facharbeit, Beratung und Material folgt nach der Inhaltsfreigabe.</p>
			</article>
		</div>
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-sand-300 uppercase">Selbst bauen, begleitet planen</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl leading-tight sm:text-5xl">Das passende Modell lässt sich gemeinsam auswählen.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Projekt besprechen</ButtonLink>
		</div>
	</section>
</BaseLayout>
