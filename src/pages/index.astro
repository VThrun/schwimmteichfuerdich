---
import ButtonLink from '../components/ui/ButtonLink.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import HeroVideo from '../components/HeroVideo.astro';
import OfferCard from '../components/OfferCard.astro';
import VisualImage from '../components/VisualImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { offers } from '../data/offers';

const benefits = [
	{
		number: '01',
		title: 'Holz gibt die Form',
		text: 'Der Holzverbau prägt Konstruktion, Atmosphäre und den natürlichen Charakter.',
	},
	{
		number: '02',
		title: 'Ein Becken genügt',
		text: 'Die Wasseraufbereitung arbeitet im selben Becken – ohne separates Filterbecken.',
	},
	{
		number: '03',
		title: 'Wie für den Garten gemacht',
		text: 'Wasser, Ufer, Terrasse und Pflanzen fügen sich zu einem stimmigen Ganzen.',
	},
];

const diySteps = [
	{ number: '01', title: 'Gemeinsam planen', text: 'Grundstück, Wünsche und Arbeitsteilung werden vorab klar festgelegt.' },
	{ number: '02', title: 'Selbst anpacken', text: 'Aushub, Pflanzflächen oder Bepflanzung können Sie selbst übernehmen.' },
	{ number: '03', title: 'Fachlich absichern', text: 'Holzverbau, Folie und Technik bleiben in professionellen Händen.' },
	{ number: '04', title: 'Mehr Garten genießen', text: 'Am Ende steht Ihre persönliche Wasserwelt – gemeinsam gebaut.' },
];

const faqs = [
	{
		question: 'Braucht ein Schwimmteich viel Platz?',
		answer: 'Nein. Kompakte Varianten lassen sich auch in kleinere Gärten einfügen. Entscheidend sind die Situation vor Ort, die gewünschte Nutzung und eine sorgfältige Planung.',
	},
	{
		question: 'Wo befindet sich das Filterbecken?',
		answer: 'Bei diesem System arbeitet die natürliche Wasseraufbereitung im selben Becken. Ein zusätzliches, separat sichtbares Filterbecken wird nicht benötigt.',
	},
	{
		question: 'Welche Arbeiten kann ich selbst übernehmen?',
		answer: 'Je nach Projekt kommen unter anderem Aushub, Gelände- und Randarbeiten sowie das Setzen eigener Wasserpflanzen infrage. Die genaue Aufteilung wird vor Baubeginn abgestimmt.',
	},
	{
		question: 'Sind die gezeigten Preise verbindlich?',
		answer: 'Nein. Im aktuellen Designstand sind alle Preise illustrative Beispiele. Verbindliche Werte folgen erst nach fachlicher Freigabe und konkreter Projektklärung.',
	},
];
---

<BaseLayout
	title="Startseite"
	description="Naturnahe Schwimmteiche und Naturpools aus Holz – als individuelle Luxusoase für kleine und große Gärten."
>
	<section class="relative overflow-hidden border-b border-stone-200 bg-sand-50">
		<div class="absolute -left-40 top-32 size-[30rem] rounded-full border border-pond-800/10" aria-hidden="true"></div>
		<div class="absolute right-[42%] top-12 size-28 rounded-full bg-sand-300/30 blur-3xl" aria-hidden="true"></div>
		<div class="mx-auto grid min-h-[46rem] max-w-[85rem] gap-14 px-4 pb-24 pt-16 sm:px-6 md:pt-20 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-20 lg:px-8 lg:py-24">
			<div class="relative z-10" data-reveal>
				<p class="eyebrow">Schwimmteiche & Naturpools aus Holz</p>
				<h1 class="mt-5 max-w-4xl font-display text-6xl font-semibold leading-[0.88] tracking-[-0.045em] text-pond-950 sm:text-7xl lg:text-[5.6rem]">
					Ihre naturnahe <span class="font-normal italic text-pond-700">Luxusoase.</span> Im eigenen Garten.
				</h1>
				<p class="mt-7 max-w-2xl text-lg leading-8 text-stone-600 sm:text-xl">
					Dunkles natürliches Wasser, ehrliches Holz und lebendiges Grün – sorgfältig geplant, damit sich Ihr Schwimmteich nicht aufdrängt, sondern anfühlt, als wäre er schon immer da gewesen.
				</p>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					<ButtonLink href="#schwimmteiche">Schwimmteiche entdecken <span aria-hidden="true">↓</span></ButtonLink>
					<ButtonLink href="/kontakt/" variant="secondary">Projekt besprechen</ButtonLink>
				</div>
				<p class="mt-7 flex items-center gap-3 text-sm font-semibold text-pond-800">
					<span class="h-px w-10 bg-sand-500" aria-hidden="true"></span>
					Luxus, der nach Garten aussieht.
				</p>
			</div>

			<div class="relative" data-reveal style="--reveal-delay: 120ms">
				<HeroVideo />
				<div class="absolute -bottom-8 -left-2 z-10 max-w-52 rounded-[1.25rem] border border-white/70 bg-white/88 p-4 shadow-xl backdrop-blur sm:-left-8 sm:p-5">
					<svg class="size-6 text-pond-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 21c4.5-2.5 7-6.1 7-10.2V5l-7-2-7 2v5.8C5 14.9 7.5 18.5 12 21Z"/><path d="M8.5 12.5 11 15l4.8-6"/></svg>
					<p class="mt-3 font-display text-xl font-semibold leading-tight text-pond-950">Natürliches Wasser. Ohne Chlorpool-Gefühl.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="relative z-20 mx-auto -mt-10 max-w-[85rem] px-4 sm:px-6 lg:px-8" aria-label="Besondere Merkmale">
		<div class="grid overflow-hidden rounded-[1.5rem] border border-white/70 bg-white shadow-[0_22px_60px_rgba(16,38,28,0.1)] lg:grid-cols-3">
			{benefits.map((benefit, index) => (
				<article class:list={['p-6 sm:p-8', index > 0 && 'border-t border-stone-200 lg:border-l lg:border-t-0']} data-reveal style={`--reveal-delay: ${index * 80}ms`}>
					<span class="text-xs font-bold tracking-wider text-sand-700">{benefit.number}</span>
					<h2 class="mt-5 font-display text-2xl font-semibold text-pond-950">{benefit.title}</h2>
					<p class="mt-2 leading-7 text-stone-600">{benefit.text}</p>
				</article>
			))}
		</div>
	</section>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-24 sm:px-6 md:py-32 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8">
		<VisualImage visual="generous" class="aspect-[4/3] rounded-[2rem]" />
		<div data-reveal>
			<p class="eyebrow">Natürlich. Bis ins Detail.</p>
			<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Wasser, Holz und Grün als ein lebendiges Ganzes.</h2>
			<p class="mt-6 text-lg leading-8 text-stone-600">
				Kein Fremdkörper im Garten und keine „blaue Bombe“: Der Schwimmteich wird aus dem Grundstück heraus gedacht. Holz gibt ihm Struktur, Pflanzen machen ihn weich und das Wasser bleibt Teil der Natur.
			</p>
			<div class="mt-8 grid gap-4 sm:grid-cols-3">
				<div class="border-l-2 border-sand-500 pl-4"><strong class="block text-pond-950">Natürliches Wasser</strong><span class="text-sm text-stone-600">ohne Chlorpool-Optik</span></div>
				<div class="border-l-2 border-sand-500 pl-4"><strong class="block text-pond-950">Natürliches Holz</strong><span class="text-sm text-stone-600">sichtbar und warm</span></div>
				<div class="border-l-2 border-sand-500 pl-4"><strong class="block text-pond-950">Natürliches Grün</strong><span class="text-sm text-stone-600">lebendig eingebunden</span></div>
			</div>
		</div>
	</section>

	<section id="schwimmteiche" class="overflow-hidden border-y border-stone-200 bg-white py-24 md:py-32">
		<div class="mx-auto grid max-w-[85rem] gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_0.65fr] lg:items-end lg:px-8" data-reveal>
			<div>
				<p class="eyebrow">Zehn Ausgangspunkte</p>
				<h2 class="mt-4 max-w-4xl font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Welche Wasserwelt passt zu Ihrem Garten?</h2>
			</div>
			<div>
				<p class="leading-7 text-stone-600">Von der kompakten Abkühlung bis zum großzügigen Schwimmteich: Alle Varianten bleiben vergleichbar, werden aber individuell geplant.</p>
				<div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-pond-800">
					<span class="rounded-full bg-pond-50 px-3 py-1.5">Vollverbau</span>
					<span class="rounded-full bg-pond-50 px-3 py-1.5">Naturpool</span>
					<span class="rounded-full bg-pond-50 px-3 py-1.5">Teilverbaut</span>
					<span class="rounded-full bg-pond-50 px-3 py-1.5">Individuell</span>
				</div>
			</div>
		</div>

		<div class="mx-auto mt-10 flex max-w-[85rem] items-center justify-between gap-4 px-4 text-sm font-semibold text-stone-600 sm:px-6 lg:px-8">
			<p>Seitlich wischen oder scrollen</p>
			<a class="text-pond-700 transition hover:text-pond-950" href="/angebote/">Alle Schwimmteiche im Überblick →</a>
		</div>
		<div class="mt-5 flex snap-x snap-mandatory gap-5 overflow-x-auto px-[max(1rem,calc((100vw-85rem)/2))] pb-10 [scrollbar-width:thin] [scrollbar-color:#96b28f_transparent]">
			{offers.map((offer, index) => <OfferCard {...offer} index={index + 1} class="w-[19rem] shrink-0 snap-start sm:w-[23rem]" />)}
		</div>
		<p class="mx-auto max-w-[85rem] px-4 text-xs leading-5 text-stone-500 sm:px-6 lg:px-8">Alle Preisangaben sind illustrative Designbeispiele, nicht fachlich freigegeben und kein verbindliches Angebot.</p>
	</section>

	<section class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
		<div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
			<div class="flex flex-col justify-between rounded-[2rem] bg-pond-800 p-8 text-white sm:p-10" data-reveal>
				<div>
					<p class="text-xs font-bold tracking-[0.2em] text-sand-300 uppercase">Auch auf wenig Raum</p>
					<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95]">Ein kleiner Garten kann sich groß anfühlen.</h2>
					<p class="mt-6 leading-7 text-pond-100">Die passende Proportion ist wichtiger als die Grundstücksgröße. Kompakte Modelle schaffen einen natürlichen Ruhepol, ohne den Garten zu dominieren.</p>
				</div>
				<a class="mt-8 font-semibold text-sand-300 transition hover:text-white" href="/angebote/schwimmteich-kompakt/">Kompakte Variante ansehen →</a>
			</div>
			<div class="grid gap-5 sm:grid-cols-2">
				<VisualImage visual="compact" class="aspect-[4/5] rounded-[2rem]" sizes="(min-width: 1024px) 28vw, 100vw" />
				<VisualImage visual="evening" class="aspect-[4/5] rounded-[2rem]" imageClass="object-[58%_center]" sizes="(min-width: 1024px) 28vw, 100vw" />
			</div>
		</div>
	</section>

	<section class="wood-grain text-white">
		<div class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
				<VisualImage visual="diy" class="aspect-[4/3] rounded-[2rem] ring-1 ring-white/20" />
				<div data-reveal>
					<p class="text-xs font-bold tracking-[0.2em] text-sand-300 uppercase">Do It Yourself</p>
					<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] sm:text-6xl">Selbst mitbauen. Sichtbar sparen.</h2>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-sand-100">Sie entscheiden, wie viel Sie selbst übernehmen. Wir legen vorher offen, wo Eigenleistung sinnvoll ist und welche Schritte fachlich abgesichert bleiben.</p>
					<div class="mt-8 grid gap-3 sm:grid-cols-2">
						<div class="rounded-2xl border border-white/15 bg-white/8 p-5"><strong class="text-sand-200">Ihr möglicher Anteil</strong><p class="mt-2 text-sm leading-6 text-sand-100">Aushub, Gelände, Pflanzflächen und eigene Wasserpflanzen.</p></div>
						<div class="rounded-2xl border border-white/15 bg-white/8 p-5"><strong class="text-sand-200">Unser Fachanteil</strong><p class="mt-2 text-sm leading-6 text-sand-100">Planung, Holzverbau, Folie, Anschlüsse und Inbetriebnahme.</p></div>
					</div>
					<div class="mt-8"><ButtonLink href="/do-it-yourself/" variant="light">DIY-Möglichkeiten ansehen</ButtonLink></div>
				</div>
			</div>

			<ol class="mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
				{diySteps.map((step, index) => (
					<li class="rounded-2xl border border-white/15 bg-white/7 p-5 backdrop-blur" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
						<span class="text-xs font-bold text-sand-300">{step.number}</span>
						<h3 class="mt-7 font-display text-2xl font-semibold">{step.title}</h3>
						<p class="mt-2 text-sm leading-6 text-sand-100">{step.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-24 sm:px-6 md:py-32 lg:grid-cols-2 lg:items-center lg:px-8">
		<div data-reveal>
			<p class="eyebrow">Ein Stück Natur zurückgeben</p>
			<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Aus einem Badeplatz wird ein Biotop.</h2>
			<p class="mt-6 text-lg leading-8 text-stone-600">Wo Wasser und heimische Pflanzen zusammenkommen, entsteht neuer Lebensraum. Libellen, Frösche und Vögel können den Teich entdecken – und Ihr Garten gewinnt mit jeder Jahreszeit an Leben.</p>
			<p class="mt-6 border-l-2 border-sand-500 pl-5 font-display text-2xl italic leading-snug text-pond-800">Nicht nur nehmen. Der Natur auch etwas zurückgeben.</p>
		</div>
		<VisualImage visual="biotope" class="aspect-[4/3] rounded-[2rem]" />
	</section>

	<section class="border-y border-stone-200 bg-pond-50">
		<div class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
			<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
				<div>
					<p class="eyebrow">Bilder, die Lust auf Garten machen</p>
					<h2 class="mt-4 max-w-4xl font-display text-5xl font-semibold leading-[0.95] text-pond-950 sm:text-6xl">Wasserwelten und besondere Details.</h2>
				</div>
				<a class="shrink-0 font-semibold text-pond-700 hover:text-pond-950" href="/galerie/">Zur ganzen Galerie →</a>
			</div>
			<div class="mt-12"><GalleryGrid id="home-gallery" count={6} compact /></div>
		</div>
	</section>

	<section class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 md:py-32 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
			<div data-reveal>
				<p class="eyebrow">Gut zu wissen</p>
				<h2 class="mt-4 font-display text-5xl font-semibold leading-[0.95] text-pond-950">Die ersten Fragen, klar beantwortet.</h2>
			</div>
			<div class="divide-y divide-stone-300 border-y border-stone-300">
				{faqs.map((faq) => (
					<details class="group py-1" data-reveal>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold text-pond-950 marker:hidden">
							{faq.question}
							<span class="grid size-8 shrink-0 place-items-center rounded-full border border-stone-300 text-pond-700 transition group-open:rotate-45" aria-hidden="true">+</span>
						</summary>
						<p class="max-w-2xl pb-6 leading-7 text-stone-600">{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div data-reveal>
				<p class="text-xs font-bold tracking-[0.2em] text-sand-300 uppercase">Ihr Garten. Ihr Wasser.</p>
				<h2 class="mt-3 max-w-4xl font-display text-5xl font-semibold leading-[0.95] sm:text-6xl">Lassen Sie uns Ihre Luxusoase gemeinsam denken.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Projekt anfragen</ButtonLink>
		</div>
	</section>

	<details class="group fixed bottom-6 right-6 z-40 hidden max-w-[calc(100vw-2rem)] text-sm sm:block">
		<summary class="ml-auto flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-white/60 bg-sand-200 px-4 py-3 font-bold text-pond-950 shadow-xl transition hover:-translate-y-0.5 marker:hidden">
			<span class="text-lg" aria-hidden="true">＋</span> Auch rund um den Teich
		</summary>
		<div class="mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-2xl border border-white/60 bg-white p-5 shadow-2xl">
			<p class="font-display text-2xl font-semibold text-pond-950">Der Garten hört nicht am Wasser auf.</p>
			<p class="mt-2 leading-6 text-stone-600">Terrassen, Pflaster und Natursteinmauern planen wir auf Wunsch als stimmiges Umfeld mit.</p>
			<a class="mt-4 inline-flex font-semibold text-pond-700 hover:text-pond-950" href="/gartengestaltung/">Gartengestaltung ansehen →</a>
		</div>
	</details>
</BaseLayout>
