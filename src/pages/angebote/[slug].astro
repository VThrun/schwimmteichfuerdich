---
import GalleryGrid from '../../components/GalleryGrid.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { offers, type Offer } from '../../data/offers';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return offers.map((offer) => ({
		params: { slug: offer.slug },
		props: { offer },
	}));
}

interface Props {
	offer: Offer;
}

const { offer } = Astro.props;
const detailPlaceholders = [
	'Maße und Aufteilung werden ergänzt',
	'Materialien und Technik werden ergänzt',
	'Ausführung und Optionen werden ergänzt',
];
---

<BaseLayout
	title={offer.title}
	description={`Vorbereitete Detailseite für ${offer.title}. Inhalte und technische Angaben folgen nach der Freigabe.`}
>
	<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 md:py-20 lg:px-8">
		<a class="inline-flex items-center gap-2 text-sm font-semibold text-pond-700 hover:text-pond-900" href="/angebote/">
			<span aria-hidden="true">←</span> Alle Angebote
		</a>

		<div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
			<MediaPlaceholder label={`Produktbild für ${offer.title} folgt`} variant={offer.visual} shape="landscape" />
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">{offer.category}</p>
				<h1 class="mt-4 font-display text-5xl leading-tight text-pond-950 sm:text-6xl">{offer.title}</h1>
				<p class="mt-6 max-w-xl text-lg leading-8 text-stone-600">
					Hier folgt später die fachlich geprüfte Produktbeschreibung. Dieser Bereich zeigt
					bereits die vorgesehene Textlänge und Seitenaufteilung.
				</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl border border-stone-200 bg-white p-5">
						<p class="text-xs font-bold tracking-wider text-pond-700 uppercase">Do It Yourself</p>
						<p class="mt-3 font-display text-3xl text-pond-950">{offer.priceLabel}</p>
						<p class="mt-2 text-sm text-stone-500">{offer.customPrice ? 'Individuelles Angebot · Platzhalter' : 'inkl. MwSt. · Platzhalter'}</p>
					</div>
					<div class="rounded-2xl border border-pond-800 bg-pond-800 p-5 text-white">
						<p class="text-xs font-bold tracking-wider text-sand-300 uppercase">Badefertig</p>
						<p class="mt-3 font-display text-3xl">{offer.customPrice ? 'Preis auf Anfrage' : 'ab XX.XXX €'}</p>
						<p class="mt-2 text-sm text-pond-200">{offer.customPrice ? 'Individuelles Angebot · Platzhalter' : 'inkl. MwSt. · Platzhalter'}</p>
					</div>
				</div>
				<p class="mt-4 text-sm text-stone-500">Alle Preisangaben dienen ausschließlich der Darstellung des späteren Designs.</p>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto grid max-w-[85rem] gap-12 px-4 py-20 sm:px-6 md:grid-cols-[0.8fr_1.2fr] md:py-28 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Produktdetails</p>
				<h2 class="mt-4 font-display text-4xl leading-tight text-pond-950 sm:text-5xl">Die wichtigsten Angaben auf einen Blick.</h2>
				<p class="mt-6 leading-7 text-stone-600">Die endgültigen Maße, Materialien und Ausstattungsmerkmale werden nach der Kundenfreigabe eingetragen.</p>
			</div>
			<div class="grid gap-4">
				{detailPlaceholders.map((item, index) => (
					<div class="grid grid-cols-[3rem_1fr] items-center gap-4 rounded-2xl border border-stone-200 bg-stone-50 p-5 sm:p-6">
						<span class="font-display text-2xl text-pond-700">{String(index + 1).padStart(2, '0')}</span>
						<strong class="text-pond-950">{item}</strong>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
		<div class="grid gap-8 lg:grid-cols-2">
			<article class="rounded-2xl border border-stone-200 bg-white p-7 sm:p-9">
				<p class="text-xs font-bold tracking-wider text-pond-700 uppercase">Leistungsumfang</p>
				<h2 class="mt-3 font-display text-3xl text-pond-950">Enthaltene Leistungen folgen.</h2>
				<ul class="mt-6 divide-y divide-stone-200 border-y border-stone-200">
					{Array.from({ length: 4 }, (_, index) => (
						<li class="flex items-center gap-3 py-4 text-stone-600"><span class="text-reed-600" aria-hidden="true">✓</span> Leistungsposition {String(index + 1).padStart(2, '0')}</li>
					))}
				</ul>
			</article>
			<article class="rounded-2xl border border-stone-200 bg-sand-50 p-7 sm:p-9">
				<p class="text-xs font-bold tracking-wider text-sand-700 uppercase">Bauseitige Leistungen</p>
				<h2 class="mt-3 font-display text-3xl text-pond-950">Abgrenzung wird ergänzt.</h2>
				<p class="mt-6 leading-7 text-stone-600">Hier werden später klar und verständlich alle Leistungen aufgeführt, die nicht Bestandteil des jeweiligen Angebots sind.</p>
			</article>
		</div>
	</section>

	<section class="bg-pond-50">
		<div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
			<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-sm font-bold tracking-[0.18em] text-pond-700 uppercase">Einblicke</p>
					<h2 class="mt-3 font-display text-4xl text-pond-950 sm:text-5xl">Projektbilder folgen.</h2>
				</div>
				<a class="font-semibold text-pond-700 hover:text-pond-900" href="/galerie/">Zur Galerie →</a>
			</div>
			<div class="mt-10">
				<GalleryGrid id={`detail-${offer.slug}`} count={3} compact />
			</div>
		</div>
	</section>

	<section class="bg-pond-800 text-white">
		<div class="mx-auto flex max-w-[85rem] flex-col gap-8 px-4 py-16 sm:px-6 md:flex-row md:items-end md:justify-between md:py-20 lg:px-8">
			<div>
				<p class="text-sm font-bold tracking-[0.18em] text-sand-300 uppercase">Interesse an dieser Variante?</p>
				<h2 class="mt-3 max-w-3xl font-display text-4xl leading-tight sm:text-5xl">Das Projekt kann später konkret besprochen werden.</h2>
			</div>
			<ButtonLink href="/kontakt/" variant="light" class="shrink-0">Kontakt aufnehmen</ButtonLink>
		</div>
	</section>
</BaseLayout>
